# Daily Intelligence Environment Configuration
APP_NAME=Daily Intelligence
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
SECRET_KEY=dev-secret-change-in-production-key-32chars

# Timezone & Briefing Schedule (IST)
TIMEZONE=Asia/Kolkata
MORNING_BRIEFING_TIME=06:00
EVENING_BRIEFING_TIME=18:00
AUTO_UPDATE_ENABLED=true

# Database (SQLite with WAL mode)
DATABASE_URL=sqlite:///./data/daily_intelligence.db

# Storage & Logging
DATA_DIR=./data
LOG_DIR=./logs
LOG_LEVEL=INFO

# AI Provider Configuration (Optional, defaults to 'none' with rule-based fallback)
# Supported: none | gemini | ollama | openai
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash
AI_BASE_URL=

# Translation Configuration (Optional, defaults to 'free' with fallback to English)
# Supported: free | gemini | offline
TRANSLATION_PROVIDER=free

# News Ingestion Settings
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT_SECONDS=15
USER_AGENT=DailyIntelligence/1.0 (+http://127.0.0.1:8000)
